# NFX-Identity Docker Compose Environment Variables
# 项目配置 / Project Configuration

# ============================================
# NFX-Edge 路由 Host（本栈不跑 Traefik）
# Traefik routing hosts — NFX-Edge is the only reverse proxy
# ============================================
TRAEFIK_API_HOST=api.nebulaforgex.com
TRAEFIK_CONSOLE_HOST=admin.nebulaforgex.com

# ============================================
# 服务端口配置 / Service Ports Configuration
# ============================================
HTTP_PORT=8080
CONSOLE_PORT=80
CONSOLE_EXTERNAL_PORT=10203
VITE_PORT=5173
# Browser API origin — CityPulso-style: dev hits LAN Edge, not a public hostname.
# 浏览器 API 根。dev：局域网 Edge（登录/图片 → 192.168.1.64/nfx-identity/auth|asset/...）。
# secure：https://api.nebulaforgex.com/nfx-identity
VITE_API_URL=http://192.168.1.64/nfx-identity
VITE_WS_URL=ws://192.168.1.64/nfx-identity
VITE_BUILD_ENV=dev
VITE_APP_ID=nfx-console-dev

# ============================================
# gRPC：容器内 GRPC_PORT_*（50071+）；主机 GRPC_EXT_*（10200+）
# compose maps "${GRPC_EXT_PORT_*}:${GRPC_PORT_*}" — 对齐 PulsoLink-API
# ============================================
GRPC_PORT_AUTH=50071
GRPC_PORT_ASSET=50072
GRPC_PORT_SYSTEM=50073

GRPC_EXT_PORT_AUTH=10200
GRPC_EXT_PORT_ASSET=10201
GRPC_EXT_PORT_SYSTEM=10202

# ============================================
# gRPC 服务主机（compose 服务名，容器内互调；对齐 example GRPC_HOST_AUTH=auth-base）
# ============================================
GRPC_HOST_AUTH=auth-base
GRPC_HOST_ASSET=asset-base
GRPC_HOST_SYSTEM=system-base

# ============================================
# API 路径前缀 / API Path Prefixes
# ============================================
# Traefik gateway prefix (Edge PathPrefix + StripPrefix). Fiber still mounts /auth /asset /system.
# Edge 网关前缀；StripPrefix 后后端仍是 /auth /asset /system。
API_GATEWAY_PREFIX=/nfx-identity
API_PREFIX_PATH_AUTH=/auth
API_PREFIX_PATH_ASSET=/asset
API_PREFIX_PATH_SYSTEM=/system

# ============================================
# PostgreSQL 配置 / PostgreSQL Configuration
# ============================================
POSTGRESQL_HOST=192.168.1.64
POSTGRESQL_PORT=10104
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=Lucas127.
POSTGRESQL_NAME_DEV=nfxidentity_dev
POSTGRESQL_NAME_PROD=nfxidentity
POSTGRESQL_NAME_SHADOW=nfxidentity_diff
POSTGRES_SSLMODE=disable
POSTGRES_CONTAINER_NAME=NFX-Stack-PostgreSQL
ATLAS_POSTGRES_HOST=192.168.1.64
ATLAS_POSTGRES_PORT=10104

# ============================================
# Redis 配置 / Redis Configuration
# ============================================
REDIS_HOST=192.168.1.64
REDIS_PORT=10106
REDIS_PASSWORD=Lucas127.

# ============================================
# Kafka 配置 / Kafka Configuration
# Compose: kafka:9092 PLAINTEXT on nfx-stack. Host go run: 192.168.1.64:10108
# ============================================
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BROKERS=kafka:9092

# ============================================
# Token 配置 / Token Configuration
# ============================================
TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
TOKEN_ISSUER=nfxidentity
TOKEN_ACCESS_TTL=24h
TOKEN_REFRESH_TTL=168h
TOKEN_ALGORITHM=HS256

# ============================================
# Email 配置 / Email Configuration
# ============================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-google-email-app-password-here
EMAIL_SMTP_FROM=your-email@gmail.com

# ============================================
# MinIO (NFX-Stack) / OTEL
# Must match NFX-Stack MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# Compose: minio:9000 / otel-collector:4317. Host go run: 192.168.1.64:10112 / 10116
# gRPC WithEndpoint wants host:port (no scheme).
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<YOUR_MINIO_ROOT_USER>
MINIO_SECRET_KEY=<YOUR_MINIO_ROOT_PASSWORD>
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
